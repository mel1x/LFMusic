{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lf-music",
  "version": "0.1.0",
  "identifier": "com.lf-music.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LFMusic",
        "width": 1460,
        "height": 860,
        "minWidth": 1144,
        "minHeight": 675,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
