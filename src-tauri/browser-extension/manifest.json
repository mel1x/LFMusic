{
  "manifest_version": 3,
  "name": "LFMusic Browser Bridge",
  "description": "Передаёт cookies YouTube/YouTube Music в приложение LFMusic для стабильного скачивания треков.",
  "version": "1.0.0",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://google.com/*",
    "https://*.google.com/*",
    "https://accounts.google.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "LFMusic Browser Bridge",
    "default_popup": "popup.html"
  }
}
